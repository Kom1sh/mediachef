<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Дополнения к Info.plist, которые Tauri подмешивает к сгенерированному.

  NSMicrophoneUsageDescription обязателен для диктовки: без него macOS не
  показывает диалог доступа, а молча отдаёт тишину. Приложение при этом
  исправно «записывает» пустой звук и никогда не узнаёт, почему речи не
  слышно, — отладить такое с нуля стоит часа.

  Текст показывается человеку в системном диалоге, поэтому он объясняет и
  когда мы слушаем, и куда девается речь.
-->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>MediaChef слушает микрофон только когда вы нажали хоткей диктовки. Речь распознаётся на этом компьютере и никуда не отправляется.</string>
</dict>
</plist>
