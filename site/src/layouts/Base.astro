---
import "@fontsource/unbounded/600.css";
import "@fontsource/unbounded/700.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { T, SITE, LOCALES, LOCALE_META, NOINDEX, pathFor, type Locale, type PageId } from "../content";

interface Props {
  locale: Locale;
  page: PageId;
  title: string;
  description: string;
  jsonLd: unknown[];
  /** «article» для страниц-гайдов: это разбор темы, а не раздел сайта.
   *  Тип влияет на то, как ссылку разворачивают соцсети и чат-клиенты. */
  ogType?: "website" | "article";
}
const { locale, page, title, description, jsonLd, ogType = "website" } = Astro.props;
// Вне индекса — по списку NOINDEX, а не по флагу от макета: так страница не
// может оказаться в карте сайта и одновременно закрытой от робота.
const noindex = NOINDEX.includes(page);
const t = T[locale];
const meta = LOCALE_META[locale];

const canonical = SITE + pathFor(page, locale);
// Взаимные hreflang по всем локалям: страница знает про все свои переводы,
// иначе Google не сшивает их в одну группу.
const alternates = LOCALES.map((l) => ({ l, href: SITE + pathFor(page, l) }));
// Корень редиректит только главную, поэтому x-default для главной — сам корень,
// а для посадочных — их англоязычная версия.
const xDefault = page === "home" ? `${SITE}/` : SITE + pathFor(page, "en");

const homePath = pathFor("home", locale);
---

<!doctype html>
<html lang={meta.lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* hreflang только у индексируемых страниц: у закрытой от робота набор
        переводов ни на что не влияет, а разметку засоряет. `follow` при этом
        оставлен — ссылки с формы на остальной сайт должны работать. */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      </>
    )}
    {/* Указатель на llms.txt — карту сайта для ассистентов.

        Зачем он понадобился: журнал заходов роботов показал, что за llms.txt
        не пришёл НИ ОДИН робот, тогда как robots.txt за те же полдня забрали
        девять раз шестеро. Файл лежал по договорному адресу и был сиротой:
        найти его можно было только угадав путь.

        `rel="describedby"` — то, что предписывает сама спецификация
        llmstxt.org; robots.txt она для этого прямо не рекомендует, у него
        другая задача. Тот же указатель уезжает и заголовком `Link` из
        _worker.js — для клиентов, которые смотрят заголовки, а не разметку. */}
    <link rel="describedby" href={`${SITE}/llms.txt`} type="text/plain" />
    {/* Порядок не случаен. Первым — /favicon.ico: именно его роботы Яндекса и
        Bing запрашивают вслепую, не читая разметку, и его у сайта не было
        совсем. Дальше SVG для браузеров (Яндекс его тоже понимает и даже
        предпочитает) и растр 120×120, который Яндекс называет удобным для
        своих сервисов. Все три лежат в public/ и раздаются с корня без хеша
        в имени — иначе слепой запрос /favicon.ico опять упрётся в 404. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-120.png" type="image/png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="MediaChef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
    ))}
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MediaChef" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F7F8FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1116" media="(prefers-color-scheme: dark)" />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    {/* Счётчики: Яндекс.Метрика 112053786 и Google Analytics 4 G-4D2TD96BF8.

        Работают сразу у всех, баннер сообщает о них и даёт «Отключить».
        Решение Егора от 19.09.2026: сначала счётчики ждали «Разрешить» везде,
        потом только в ЕС, и в обоих вариантах данных становилось заметно
        меньше. Известная цена: для посетителей из ЕС (GDPR требует согласия
        заранее) это формально нарушение. Вернуть вопрос для ЕС — коммит
        79f6137 в истории: пометка страны в _worker.js и второй текст баннера.

        Выбор хранится в localStorage (`mc-consent`: granted | denied). Это не
        cookie и никуда не уходит — только чтобы не спрашивать на каждой
        странице. Вернувшийся с согласием получает счётчики сразу, в <head>, а
        не после отрисовки: иначе первый просмотр каждой страницы терялся бы.

        «Отключить» / «Отказаться» (и позже — через «Настройки cookies» в
        подвале) стирает cookies и локальные записи обоих счётчиков на этом
        домене и поднимает их штатные флаги отключения: `ga-disable-<ID>` у GA
        и `disableYaCounter<ID>` у Метрики — чтобы уже загруженные в этой
        вкладке скрипты больше ничего не отправили. Со следующей страницы их
        нет вовсе.

        Событие `download_app` — ради скачиваний: встроенное «скачивание файла»
        GA4 знает .exe и .zip, но не .dmg, .AppImage и .deb. Одно событие на
        любой файл релиза, с именем файла и системой; клик ловится на уровне
        документа, чтобы новая кнопка скачивания не выпала из счёта.

        `is:inline` обязателен: иначе Astro утащит скрипт в бандл и перепишет,
        а сниппеты счётчиков должны уехать в страницу дословно. */}
    <script is:inline>
      (function () {
        var KEY = 'mc-consent';
        function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
        function write(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }

        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;

          // Яндекс.Метрика — сниппет из кабинета. Домен .com, а не .ru: с него
          // отдаётся тот же tag.js, но он не заблокирован там, где резолв
          // mc.yandex.ru ломается.
          (function(m,e,t,r,i,k,a){
              m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
              m[i].l=1*new Date();
              for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
              k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
          })(window, document,'script','https://mc.yandex.com/metrika/tag.js?id=112053786', 'ym');
          ym(112053786, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});

          // Google Analytics 4 — сниппет из GA, только вставка тега скриптом.
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-4D2TD96BF8';
          document.head.appendChild(g);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-4D2TD96BF8');
        }

        // Первые cookies и записи обоих счётчиков: _ga*, _gid, _gat*, _ym*.
        function forget() {
          var host = location.hostname;
          var domains = ['', host, '.' + host];
          document.cookie.split(';').forEach(function (c) {
            var name = c.split('=')[0].trim();
            if (!/^(_ga|_gid|_gat|_ym)/.test(name)) return;
            domains.forEach(function (d) {
              document.cookie = name + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
            });
          });
          try {
            for (var i = localStorage.length - 1; i >= 0; i--) {
              var k = localStorage.key(i);
              if (k && /^_ym/.test(k)) localStorage.removeItem(k);
            }
          } catch (e) {}
        }

        function stop() {
          window['ga-disable-G-4D2TD96BF8'] = true;
          window['disableYaCounter112053786'] = true;
        }

        window.mcConsent = {
          state: read,
          allow: function () { write('granted'); load(); },
          decline: function () { write('denied'); stop(); forget(); },
        };

        var choice = read();
        if (choice !== 'denied') load();

        document.addEventListener('click', function (e) {
          if (!window.gtag) return;
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || !/\/releases\/(latest\/)?download\//.test(a.href)) return;
          var file = a.href.split('?')[0].split('/').pop();
          var os = /\.(dmg)$|macos/i.test(file) ? 'macos'
            : /\.exe$|windows/i.test(file) ? 'windows'
            : /\.(AppImage|deb)$/i.test(file) ? 'linux' : 'other';
          window.gtag('event', 'download_app', { file_name: file, os: os, link_url: a.href });
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skipToContent}</a>

    <Nav locale={locale} page={page} homePath={homePath} />

    <slot />

    <Footer locale={locale} page={page} />

    {/* Баннер согласия. Плашка в углу, а не окно поверх страницы: сайт работает
        сразу и без ответа, баннер ничего не закрывает, кроме своего угла.
        Кнопки одинаковые по виду и весу — отказ должен быть так же прост, как
        согласие, иначе согласие не считается добровольным.

        Скрыт в разметке: без JS счётчиков нет, сообщать не о чем. Показ —
        скриптом ниже, если выбора ещё не было. */}
    <div class="consent" id="consent" role="region" aria-label={t.consent.label} hidden>
      <p>{t.consent.noticeText}</p>
      <div class="consent-actions">
        <button type="button" class="consent-btn" data-consent="allow">{t.consent.ok}</button>
        <button type="button" class="consent-btn" data-consent="decline">{t.consent.off}</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById('consent');
        if (!box || !window.mcConsent) return;
        if (!window.mcConsent.state()) box.hidden = false;
        box.addEventListener('click', function (e) {
          var b = e.target.closest ? e.target.closest('[data-consent]') : null;
          if (!b) return;
          window.mcConsent[b.getAttribute('data-consent')]();
          box.hidden = true;
        });
        // «Настройки cookies» в подвале: снова показать тот же выбор.
        document.addEventListener('click', function (e) {
          if (!e.target.closest || !e.target.closest('[data-consent-open]')) return;
          box.hidden = false;
          box.querySelector('button').focus();
        });
      })();
    </script>
  </body>
</html>
