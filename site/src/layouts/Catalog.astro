---
// Каталог рецептов: /<locale>/<slug>/.
//
// Страница целиком собрана из recipes/*.yaml — тех же файлов, которые читает
// приложение. Поэтому каталог не может соврать про набор: добавили рецепт —
// он появился здесь сам, на всех десяти языках, вместе с алиасами поиска.
import Base from "./Base.astro";
import Toc from "../components/Toc.astro";
import Ctas from "../components/Ctas.astro";
import { T, CATALOG, SITE, pathFor, type Locale } from "../content";
import { SECTIONS } from "../recipes";
import { organizationLd, softwareApplicationLd, breadcrumbLd, itemListLd } from "../seo";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = T[locale];
const c = CATALOG[locale];

const pageUrl = SITE + pathFor("catalog", locale);
const homePath = pathFor("home", locale);

// Порядок разделов задаёт recipes.ts, подписи — тексты локали. Категория без
// подписи выпала бы плашкой «undefined», поэтому проверяем оба словаря разом.
const groups = SECTIONS.map((s) => ({ ...s, label: c.sections[s.id] }));
const gaps = [
  ...groups.filter((g) => !g.label).map((g) => `раздел ${g.id}`),
  ...[...new Set(SECTIONS.flatMap((s) => s.recipes.map((r) => r.category)))]
    .filter((cat) => !(cat in c.cats))
    .map((cat) => `категория ${cat}`),
];
if (gaps.length) throw new Error(`catalog/${locale}: нет подписи для ${gaps.join(", ")}`);

const tocItems = groups.map((g) => ({ label: g.label, href: `#${g.id}` }));

const typeName = (kind: string) =>
  kind === "video" ? c.types.video : kind === "audio" ? c.types.audio : c.types.any;

const jsonLd = [
  organizationLd(),
  softwareApplicationLd(locale, pageUrl),
  breadcrumbLd(
    { name: t.breadcrumbHome, url: SITE + homePath },
    { name: c.crumb, url: pageUrl },
  ),
  itemListLd(
    groups.flatMap((g) => g.recipes).map((r) => ({
      name: r.title(locale),
      description: r.description(locale),
    })),
  ),
];
---

<Base locale={locale} page="catalog" title={c.title} description={c.description} jsonLd={jsonLd}>
  <main id="main">
    <div class="band band-hero">
      <div class="wrap hero hero-catalog">
        <div>
          <p class="crumbs"><a href={homePath}>MediaChef</a> <span aria-hidden="true">/</span> {c.crumb}</p>
          <h1>{c.h1}</h1>
          <Toc label={t.tocLabel} items={tocItems} />
          <p class="sub">{c.lead}</p>
          <Ctas locale={locale} anchor />
        </div>
      </div>
    </div>

    {groups.map((g, i) => (
      <section id={g.id} class={`band${i % 2 ? " band-tint" : ""}`}>
        <div class="wrap">
          <h2>{g.label}</h2>
          <ul class="cards" role="list">
            {g.recipes.map((r) => {
              const params = r.params(locale);
              const aliases = r.aliases(locale);
              return (
                <li class="card">
                  <p class="card-cat">{c.cats[r.category as keyof typeof c.cats]}</p>
                  <h3>{r.title(locale)}</h3>
                  <p class="card-desc">{r.description(locale)}</p>
                  <dl class="spec">
                    <div>
                      <dt>{c.accepts}</dt>
                      <dd>{r.accepts.map(typeName).join(" · ")}</dd>
                    </div>
                    <div>
                      <dt>{c.produces}</dt>
                      <dd><code>.{r.ext}</code></dd>
                    </div>
                    <div>
                      <dt>{c.settings}</dt>
                      <dd>
                        {params.length === 0
                          ? c.noParams
                          : params.map((p) => (
                              <span class="setting">
                                {p.label}{p.values.length > 0 && <> — {p.values.join(" / ")}</>}
                              </span>
                            ))}
                      </dd>
                    </div>
                  </dl>
                  {aliases.length > 0 && (
                    <p class="card-aka"><span>{c.searchAs}</span> {aliases.join(", ")}</p>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    ))}

    <section class="band band-close">
      <div class="wrap">
        <div class="cta-final">
          <h2>{c.ctaTitle}</h2>
          <p class="lead">{c.ctaSub}</p>
          <Ctas locale={locale} />
          <p class="ctas-note note-wide">{t.betaNote}</p>
        </div>

        <nav class="also" aria-label={t.alsoLabel}>
          <p class="eyebrow">{t.alsoLabel}</p>
          <ul>
            {c.also.map((a) => <li><a href={pathFor(a.page, locale)}>{a.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Карточки повторяют вид карточек рецептов в самом приложении: человек,
     пришедший из поиска, узнаёт их, когда открывает программу. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 14px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  /* Те же карта, рамка и радиус, что у карточек рецептов на главной. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    transition: border-color 0.12s;
  }

  .card:hover {
    border-color: var(--basil);
  }

  /* Плашка с той же категорией, что человек увидит в самом приложении. */
  .card-cat {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--basil);
  }

  .card h3 {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .card-desc {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .spec {
    display: grid;
    gap: 4px;
    margin: 4px 0 0;
    font-size: 0.8rem;
  }

  .spec > div {
    display: grid;
    grid-template-columns: minmax(5.5rem, auto) 1fr;
    gap: 10px;
    align-items: baseline;
  }

  .spec dt {
    color: var(--ink);
    font-weight: 600;
  }

  .spec dd {
    margin: 0;
    color: var(--ink-2);
  }

  .spec code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.85em;
    background: var(--card-2);
    border-radius: 6px;
    padding: 1px 6px;
    color: var(--ink);
  }

  /* Настроек у рецепта может быть несколько — каждая своей строкой, иначе
     «Качество (меньше = лучше) — 23 / 28 / 33» слипается со следующей. */
  .setting {
    display: block;
  }

  /* `margin-top: auto` прижимает список синонимов к низу карточки, поэтому
     в ряду разной высоты разделительные линии стоят на одном уровне. */
  .card-aka {
    margin: auto 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .card-aka span {
    font-weight: 600;
  }

  .hero-catalog {
    display: block;
    max-width: 48rem;
  }
</style>
