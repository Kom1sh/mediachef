---
// Кнопки загрузки. Ведут прямо на файл релиза, а не на страницу GitHub:
// клик — и файл качается. Вес и платформа подписаны на самой кнопке, чтобы
// человек знал, что получит, до клика.
import { DOWNLOADS, UI } from "../nav";
import { T, LINKS, type Locale } from "../content";

// anchor ставится только на первый блок кнопок на странице: id должен быть один.
interface Props { locale: Locale; anchor?: boolean }
const { locale, anchor = false } = Astro.props;
const t = T[locale];
const u = UI(locale);

const mac = DOWNLOADS.find((d) => d.href.endsWith(".dmg"))!;
const win = DOWNLOADS.find((d) => d.href.endsWith(".exe"))!;
const linux = DOWNLOADS.find((d) => d.href.endsWith(".AppImage"))!;
const sub = (d: typeof mac) => `${d.size} · ${(d.sub ?? d.note)[locale]}`;
---

<div class="ctas" id={anchor ? "download" : undefined}>
  <a class="btn btn-primary" href={mac.href} rel="noopener">
    <span>{t.ctaMac}</span>
    <span class="btn-sub">{sub(mac)}</span>
  </a>
  <a class="btn btn-ghost" href={win.href} rel="noopener" title={t.ctaWin}>
    <span>Windows</span>
    <span class="btn-sub">{sub(win)}</span>
  </a>
  <a class="btn btn-ghost" href={linux.href} rel="noopener" title={t.ctaLinux}>
    <span>Linux</span>
    <span class="btn-sub">{sub(linux)}</span>
  </a>
</div>
<p class="ctas-note">
  {t.ctaNote} <a href={LINKS.github}>{t.ctaNoteLink}</a>
  <span class="dot" aria-hidden="true">·</span>
  <a href={LINKS.releases} rel="noopener">{u.allFiles}</a>
</p>
