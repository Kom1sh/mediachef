---
// Шапка: категории с выпадающими списками на десктопе и тот же набор
// аккордеоном в бургере на узком экране. Оба меню строятся из navFor(),
// поэтому расходиться не могут. Клиентского JS нет: раскрытие — на <details>
// (мобильный бургер) и на :hover/:focus-within (десктопные выпадашки).
import { navFor, UI } from "../nav";
import { pathFor, type Locale, type PageId } from "../content";

interface Props { locale: Locale; page: PageId; homePath: string; switchPath: string }
const { locale, page, homePath, switchPath } = Astro.props;
const u = UI(locale);
const entries = navFor(locale, page);
const other: Locale = locale === "en" ? "ru" : "en";
const caret = `<svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>`;
---

<header class="top">
  <div class="wrap top-in">
    <a class="brand" href={homePath}>
      <svg width="30" height="30" viewBox="0 0 1024 1024" aria-hidden="true"><rect x="100" y="100" width="824" height="824" rx="185" fill="var(--card-2)"/><g><rect x="357" y="304" width="46" height="112" rx="23" fill="var(--basil)"/><rect x="432" y="252" width="46" height="164" rx="23" fill="var(--basil)"/><rect x="507" y="204" width="46" height="212" rx="23" fill="var(--basil)"/><rect x="582" y="252" width="46" height="164" rx="23" fill="var(--basil)"/><rect x="657" y="304" width="46" height="112" rx="23" fill="var(--basil)"/></g><circle cx="530" cy="452" r="30" fill="var(--amber)"/><rect x="266" y="482" width="528" height="34" rx="17" fill="var(--ink)"/><path d="M 296 542 L 764 542 L 764 700 Q 764 786 678 786 L 382 786 Q 296 786 296 700 Z" fill="var(--ink)"/><rect x="216" y="556" width="64" height="36" rx="18" fill="var(--ink)"/><rect x="780" y="556" width="64" height="36" rx="18" fill="var(--ink)"/></svg>
      <strong>MediaChef</strong>
    </a>

    <nav class="nav" aria-label={u.navLabel}>
      <ul class="nav-row">
        {entries.map((e) => (
          <li class={`nav-item${e.label === u.download ? " is-cta" : ""}`}>
            {e.groups ? (
              <Fragment>
                {/* Кнопка, а не <summary>: содержимое закрытого <details> браузер
                    прячет через ::details-content, докуда CSS-правило про
                    наведение не дотягивается. Кнопка фокусируется — значит
                    работает и :focus-within, то есть клавиатура. */}
                <button class="dd-top" type="button">
                  {e.label}
                  <Fragment set:html={caret} />
                </button>
                <div class="dd-panel">
                  {e.groups.map((g) => (
                    <div class="dd-col">
                      <p class="dd-group">{g.label}</p>
                      <ul>
                        {g.items.map((i) => (
                          <li>
                            <a href={i.href} rel={i.ext ? "noopener" : undefined}>
                              <span class="dd-label">{i.label}</span>
                              {i.note && <span class="dd-note">{i.note}</span>}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </Fragment>
            ) : (
              <a class="nav-link" href={e.href}>{e.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="top-right">
      <a class="lang" href={switchPath} hreflang={other} lang={other}>{other.toUpperCase()}</a>

      <details class="burger">
        <summary class="burger-btn" aria-label={u.menu}>
          <span class="burger-lines" aria-hidden="true"><i></i><i></i><i></i></span>
        </summary>
        <div class="burger-panel">
          <div class="wrap burger-in">
            {entries.map((e) => (
              e.groups ? (
                <details class="acc">
                  <summary class="acc-top">
                    {e.label}
                    <Fragment set:html={caret} />
                  </summary>
                  <div class="acc-body">
                    {e.groups.map((g) => (
                      <div class="acc-group">
                        <p class="dd-group">{g.label}</p>
                        <ul>
                          {g.items.map((i) => (
                            <li>
                              <a href={i.href} rel={i.ext ? "noopener" : undefined}>
                                <span class="dd-label">{i.label}</span>
                                {i.note && <span class="dd-note">{i.note}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              ) : (
                <a class="acc-link" href={e.href}>{e.label}</a>
              )
            ))}
            <a class="acc-link" href={pathFor(page, other)} hreflang={other} lang={other}>
              {other === "ru" ? "Русская версия" : "English version"}
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
